DATABASE_URL=jdbc:postgresql://localhost:5432/catspell
DATABASE_USERNAME=catspell
DATABASE_PASSWORD=catspell

# Generate a strong secret for production:
# openssl rand -base64 64
JWT_SECRET=your-jwt-secret-here

# S3 / MinIO configuration
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=catspell-photos
S3_ACCESS_KEY=catspell
S3_SECRET_KEY=catspell123

# Firebase / push notifications
# PUSH_ENABLED=true activates real FCM delivery and requires FIREBASE_CREDENTIALS_BASE64.
# Leave PUSH_ENABLED=false for local/CI (no-op logging provider, no credentials needed).
PUSH_ENABLED=false
# base64 of the Firebase service-account JSON; leave blank for local no-op.
FIREBASE_CREDENTIALS_BASE64=
